+++ b/tests/crm-settings-stepup.test.mjs
@@ -0,0 +1,70 @@
+// Proposed regression tests for SEC-FRESH-01; not executed during the checkpoint.
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync,writeFileSync} from 'node:fs';
+import {startCrm,password} from './helpers/crm-fixture.mjs';
+
+const skip=!process.env.RUBIZH_TEST_MYSQL_SOCKET;
+const reason='Synthetic settings freshness verification';
+
+test('staff and sender mutations refuse an aged OWNER before writes, then succeed after password re-login',{skip,timeout:180000},async()=>{
+ const s=await startCrm();
+ try{
+  let owner=await s.login('OWNER');
+  const settings=await owner.get('/settings');assert.equal(settings.status,200);
+  const sender=settings.data.data.sender_profiles.find(p=>p.code==='m_vin');assert.ok(sender);
+  const staffBody={email:'new-staff@fixture.test',name:'New Synthetic Staff',role:'READ_ONLY',password,reason};
+  const senderBody={...sender,name:'Updated Synthetic Sender',confirmed:false,reason};
+  const sid=owner.cookie.split('=')[1],file=s.dir+'/sess_'+sid;
+  const session=readFileSync(file,'utf8');assert.match(session,/staff_login_at\|i:\d+;/);
+  writeFileSync(file,session.replace(/staff_login_at\|i:\d+;/,'staff_login_at|i:'+(Math.floor(Date.now()/1000)-3600)+';'));
+  const auditCount=()=>+s.sql("SELECT COUNT(*) n FROM rubizh_staff_audit WHERE action IN ('staff.update','sender.update')")[0].n;
+  const beforeAudit=auditCount(),beforeSender=s.sql("SELECT name,version FROM rubizh_sender_profiles WHERE code='m_vin'")[0];
+  for(const [route,body,method] of [['/settings/staff',staffBody,'POST'],['/settings/senders/m_vin',senderBody,'PUT']]){
+   const rejected=await owner.send(route,body,method);
+   assert.equal(rejected.status,403);assert.equal(rejected.data.error.code,'REAUTH_REQUIRED');
+  }
+  assert.equal(s.sql("SELECT id FROM rubizh_staff_users WHERE email='new-staff@fixture.test'").length,0);
+  assert.deepEqual(s.sql("SELECT name,version FROM rubizh_sender_profiles WHERE code='m_vin'")[0],beforeSender);
+  assert.equal(auditCount(),beforeAudit);
+  assert.equal((await owner.get('/settings')).status,200,'stale login still permits authorized reads');
+  owner=await s.login('OWNER');
+  assert.equal((await owner.send('/settings/staff',staffBody)).status,200);
+  assert.equal((await owner.send('/settings/senders/m_vin',senderBody,'PUT')).status,200);
+  assert.equal(s.sql("SELECT id FROM rubizh_staff_users WHERE email='new-staff@fixture.test'").length,1);
+  assert.equal(+s.sql("SELECT version FROM rubizh_sender_profiles WHERE code='m_vin'")[0].version,+beforeSender.version+1);
+  assert.equal(auditCount(),beforeAudit+2);
+  const reader=await s.login('READ_ONLY');
+  const denied=await reader.send('/settings/staff',{...staffBody,email:'reader-denied@fixture.test'});
+  assert.equal(denied.status,403);assert.equal(denied.data.error.code,'PERMISSION_DENIED');
+ }finally{s.stop();}
+});
+
+test('settings freshness proof is bound to the acting staff session and verified actor, with the configured window',{skip,timeout:180000},async()=>{
+ const s=await startCrm();
+ try{
+  // A function probe on the isolated HTTP PHP SAPI, with no database or mutation.
+  writeFileSync(s.site+'/stepup-probe.php',`<?php
+  function cfg($key){return $key==='staff_stepup_seconds'?120:null;}
+  require __DIR__.'/staff/auth.php';
+  $id=str_repeat('1',32);$other=str_repeat('2',32);$actor=['id'=>$id,'role'=>'OWNER'];
+  $_SESSION=['staff_id'=>$id,'staff_login_at'=>time()];$GLOBALS['crm_staff_actor']=$actor;
+  switch($_GET['case']??''){
+   case 'wrong-session':$_SESSION['staff_id']=$other;break;
+   case 'wrong-verified':$GLOBALS['crm_staff_actor']['id']=$other;break;
+   case 'customer-only':unset($_SESSION['staff_id'],$_SESSION['staff_login_at']);$_SESSION['customer_id']=$id;$_SESSION['login_time']=time();break;
+   case 'missing-time':unset($_SESSION['staff_login_at']);break;
+   case 'future-time':$_SESSION['staff_login_at']=time()+60;break;
+   case 'outside-window':$_SESSION['staff_login_at']=time()-121;break;
+   case 'inside-window':$_SESSION['staff_login_at']=time()-119;break;
+  }
+  header('Content-Type: application/json');try{crmRequireFreshLogin($actor);echo json_encode(['ok'=>true]);}
+  catch(CrmError $e){http_response_code($e->status);echo json_encode(['code'=>$e->reason]);}
+  `);
+  for(const name of ['wrong-session','wrong-verified','customer-only','missing-time','future-time','outside-window']){
+   const rejected=await s.get('/stepup-probe.php?case='+name);
+   assert.equal(rejected.status,403,name);assert.equal(rejected.data.code,'REAUTH_REQUIRED');
+  }
+  assert.equal((await s.get('/stepup-probe.php?case=inside-window')).status,200);
+ }finally{s.stop();}
+});
