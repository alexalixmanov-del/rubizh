                  "const": true
                },
                "payment_allowed": {
                  "const": false
                },
                "requires_order_confirmation": {
                  "const": true
                },
                "stock": {
                  "const": null
                },
                "availability_status": {
                  "const": "ORDER_ON_REQUEST"
                },
                "availability_confirmation": {
                  "const": "CONFIRMED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "SIZE_CONFIRMATION_REQUIRED"
                }
              }
            },
            "then": {
              "properties": {
                "order_submission_allowed": {
                  "const": true
                },
                "payment_allowed": {
                  "const": false
                },
                "requires_order_confirmation": {
                  "const": true
                },
                "stock_status": {
                  "const": "UNKNOWN"
                },
                "stock": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "UNKNOWN"
                }
              }
            },
            "then": {
              "properties": {
                "order_submission_allowed": {
                  "const": false
                },
                "payment_allowed": {
                  "const": false
                },
                "requires_order_confirmation": {
                  "const": true
                },
                "stock_status": {
                  "const": "UNKNOWN"
                },
                "stock": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "OUT_OF_STOCK"
                }
              }
            },
            "then": {
              "properties": {
                "order_submission_allowed": {
                  "const": false
                },
                "payment_allowed": {
                  "const": false
                },
                "requires_order_confirmation": {
                  "const": false
                },
                "availability_status": {
                  "const": "OUT_OF_STOCK"
                },
                "availability_confirmation": {
                  "const": "CONFIRMED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stock_status": {
                  "enum": [
                    "CONFIRMED_BY_STATUS",
                    "CONFIRMED_BY_PRESENCE"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "stock": {
                  "const": null
                },
                "stock_quantity": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stock_status": {
                  "const": "CONFIRMED"
                }
              }
            },
            "then": {
              "properties": {
                "stock": {
                  "type": "number",
                  "minimum": 0
                },
                "stock_quantity": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability_source": {
                  "const": "QUANTITY"
                },
                "availability": {
                  "const": "IN_STOCK"
                }
              }
            },
            "then": {
              "properties": {
                "stock": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "stock_quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "stock_status": {
                  "const": "CONFIRMED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability_source": {
                  "enum": [
                    "STATUS",
                    "FEED_PRESENCE"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "stock": {
                  "const": null
                },
                "stock_quantity": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "payment_allowed": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "availability": {
                  "const": "IN_STOCK"
                },
                "availability_status": {
                  "const": "IN_STOCK"
                },
                "availability_confirmation": {
                  "const": "CONFIRMED"
                },
                "inventory_policy_confirmed": {
                  "const": true
                },
                "price_ready": {
                  "const": true
                },
                "order_submission_allowed": {
                  "const": true
                },
                "requires_order_confirmation": {
                  "const": false
                },
                "size_status": {
                  "enum": [
                    "EXACT_SIZE",
                    "ONE_SIZE",
                    "NO_SIZE_REQUIRED"
                  ]
                },
                "size_confidence_tier": {
                  "const": "SAFE_AUTO"
                },
                "source_binding_status": {
                  "const": "CONFIRMED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "IN_STOCK"
                },
                "price_ready": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "payment_allowed": {
                  "const": true
                },
                "order_submission_allowed": {
                  "const": true
                },
                "requires_order_confirmation": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "IN_STOCK"
                },
                "price_ready": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "payment_allowed": {
                  "const": false
                },
                "order_submission_allowed": {
                  "const": false
                },
                "requires_order_confirmation": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability_confirmation": {
                  "const": "CONFIRMED"
                }
              }
            },
            "then": {
              "properties": {
                "availability_source": {
                  "enum": [
                    "QUANTITY",
                    "STATUS",
                    "FEED_PRESENCE",
                    "MANUAL"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability_source": {
                  "const": "STATUS"
                },
                "availability": {
                  "const": "IN_STOCK"
                }
              }
            },
            "then": {
              "properties": {
                "inventory_mode": {
                  "const": "STATUS"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability_source": {
                  "const": "FEED_PRESENCE"
                }
              }
            },
            "then": {
              "properties": {
                "inventory_mode": {
                  "const": "FEED_PRESENCE"
                }
              }
            }
          }
        ],
        "not": {
          "required": [
            "checkout_allowed"
          ]
        }
      }
    },
    "colors": {
      "type": "array"
    },
    "order_submission_allowed": {
      "type": "boolean"
    },
    "payment_allowed": {
      "type": "boolean"
    },
    "requires_order_confirmation": {
      "type": "boolean"
    },
    "order_policy_version": {
      "const": 1
    },
    "availability": {
      "enum": [
        "IN_STOCK",
        "OUT_OF_STOCK",
        "PREORDER",
        "ORDER_ON_REQUEST",
        "UNKNOWN",
        "SIZE_CONFIRMATION_REQUIRED"
      ]
    },
    "inventory_policy_version": {
      "const": 1
    }
  },
  "not": {
    "required": [
      "checkout_allowed"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "payment_allowed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "availability": {
            "const": "IN_STOCK"
          },
          "variants": {
            "contains": {
              "properties": {
                "payment_allowed": {
                  "const": true
                }
              },
              "required": [
                "payment_allowed"
              ]
            }
          }
        }
      }
    }
  ]
