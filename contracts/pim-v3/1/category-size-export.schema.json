                "availability_status": {
                  "const": "PREORDER"
                },
                "availability_confirmation": {
                  "const": "CONFIRMED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "ORDER_ON_REQUEST"
