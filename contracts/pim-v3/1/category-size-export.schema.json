            "minimum": 0
          },
          "stock_status": {
            "enum": [
              "CONFIRMED",
              "CONFIRMED_BY_STATUS",
              "CONFIRMED_BY_PRESENCE",
              "UNKNOWN"
            ]
          },
          "availability": {
            "enum": [
              "IN_STOCK",
              "OUT_OF_STOCK",
              "PREORDER",
              "ORDER_ON_REQUEST",
              "UNKNOWN",
              "SIZE_CONFIRMATION_REQUIRED"
            ]
          },
