          "availability_confirmation": {
            "enum": [
              "CONFIRMED",
              "UNKNOWN"
            ]
          },
          "inventory_mode": {
            "enum": [
              "QUANTITY",
              "STATUS",
              "FEED_PRESENCE",
              "NO_AVAILABILITY_SIGNAL"
