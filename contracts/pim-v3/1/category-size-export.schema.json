            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source_updated_at": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "stock_data_age_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "stale_source": {
            "type": "boolean"
          },
          "stock_warning_hours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "stock_quantity": {
            "type": [
              "number",
              "null"
